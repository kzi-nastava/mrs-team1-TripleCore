<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/white">

        <!-- Route -->
        <TextView
            android:id="@+id/tvPassengerRoute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Route Details"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/purple"
            android:layout_marginBottom="8dp"/>

        <!-- Map -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginBottom="16dp">

            <org.osmdroid.views.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>

        <!-- Ride Info -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ride Info"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/purple"/>
        <TextView
            android:id="@+id/tvPassengerRideInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:layout_marginTop="4dp"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/light_purple"
            android:layout_marginVertical="8dp"/>

        <!-- Driver -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Driver"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/purple"/>
        <TextView
            android:id="@+id/tvPassengerDriver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:layout_marginTop="4dp"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/light_purple"
            android:layout_marginVertical="8dp"/>

        <!-- Passengers -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Passengers"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/purple"/>
        <TextView
            android:id="@+id/tvPassengerPassengers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:layout_marginTop="4dp"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/light_purple"
            android:layout_marginVertical="8dp"/>

        <!-- Inconsistencies -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inconsistencies"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/purple"/>
        <TextView
            android:id="@+id/tvPassengerInconsistencies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:layout_marginTop="4dp"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/light_purple"
            android:layout_marginVertical="8dp"/>

        <!-- Ratings
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ride Ratings"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/purple"/>
         <TextView
            android:id="@+id/tvPassengerRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:layout_marginTop="4dp"/>
            -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/light_purple"
            android:layout_marginVertical="8dp"/>

        <!-- Repeat Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnRepeatNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Repeat Now"
                android:backgroundTint="@color/purple"
                android:textColor="@android:color/white"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_marginEnd="10dp"
                android:clipToOutline="true"/>

            <Button
                android:id="@+id/btnRepeatLater"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Repeat Later"
                android:backgroundTint="@color/light_purple"
                android:textColor="@color/purple"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clipToOutline="true"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
