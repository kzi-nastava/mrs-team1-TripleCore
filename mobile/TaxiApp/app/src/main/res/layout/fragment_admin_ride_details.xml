<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/white">

        <!-- Route -->
        <TextView
            android:id="@+id/tvAdminRoute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Route Details"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/purple"
            android:layout_marginBottom="8dp"/>

        <!-- Map -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginBottom="16dp">

            <org.osmdroid.views.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </FrameLayout>

        <!-- Ride Info -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ride Info"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/purple"/>
        <TextView
            android:id="@+id/tvAdminRideInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:layout_marginTop="4dp"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/light_purple"
            android:layout_marginVertical="8dp"/>

        <!-- Driver -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Driver"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/purple"/>
        <TextView
            android:id="@+id/tvAdminDriver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:layout_marginTop="4dp"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/light_purple"
            android:layout_marginVertical="8dp"/>

        <!-- Passengers -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Passengers"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/purple"/>
        <TextView
            android:id="@+id/tvAdminPassengers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:layout_marginTop="4dp"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/light_purple"
            android:layout_marginVertical="8dp"/>

        <!-- Inconsistencies -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inconsistencies"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/purple"/>
        <TextView
            android:id="@+id/tvAdminInconsistencies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:layout_marginTop="4dp"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/light_purple"
            android:layout_marginVertical="8dp"/>

        <!-- Ratings -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ride Ratings"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/purple"/>
        <TextView
            android:id="@+id/tvAdminRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:layout_marginTop="4dp"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/light_purple"
            android:layout_marginVertical="8dp"/>

        <!-- PANIC Info -->
        <TextView
            android:id="@+id/tvAdminPanicTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PANIC Info"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/red"
            android:visibility="gone"/>
        <TextView
            android:id="@+id/tvAdminPanic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/red"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>
