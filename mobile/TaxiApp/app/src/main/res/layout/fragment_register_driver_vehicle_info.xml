<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF8FB">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/register_driver"
            android:textColor="#6A1B9A"
            android:textSize="32sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vehicle_info"
            android:textColor="#6A1B9A"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/fieldsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <EditText
                android:id="@+id/etVehicleBrand"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/vehicle_brand"
                android:background="@drawable/rounded_input"
                android:paddingStart="20dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etVehicleModel"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/vehicle_model"
                android:background="@drawable/rounded_input"
                android:paddingStart="20dp"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/textInputLayoutVehicleType"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                app:boxBackgroundColor="#E0E0E0"
                app:boxCornerRadiusBottomEnd="25dp"
                app:boxCornerRadiusBottomStart="25dp"
                app:boxCornerRadiusTopEnd="25dp"
                app:boxCornerRadiusTopStart="25dp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="0dp"
                app:hintEnabled="false">
                <AutoCompleteTextView
                android:id="@+id/spinnerVehicleType"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                    android:background="@null"
                android:hint="@string/vehicle_type"
                android:inputType="none"
                android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                android:textSize="16sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <EditText
                android:id="@+id/etPlateNumber"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/licence_plate_number"
                android:background="@drawable/rounded_input"
                android:paddingStart="20dp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etNumberOfSeats"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="@string/number_of_seats"
                android:background="@drawable/rounded_input"
                android:paddingStart="20dp"
                android:inputType="number"
                android:layout_marginBottom="12dp"/>

        </LinearLayout>

        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#D1C4E9"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/fieldsLayout"/>

        <LinearLayout
            android:id="@+id/optionsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/divider">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/baby_transport_available"
                    android:textColor="#6A1B9A" />
                <RadioGroup
                    android:id="@+id/rgBaby"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <RadioButton android:id="@+id/rbBabyYes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/yes" />
                    <RadioButton android:id="@+id/rbBabyNo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/no" android:checked="true" />
                </RadioGroup>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pets_transport_available"
                    android:textColor="#6A1B9A" />
                <RadioGroup
                    android:id="@+id/rgPets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <RadioButton android:id="@+id/rbPetsYes" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/yes" />
                    <RadioButton android:id="@+id/rbPetsNo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/no" android:checked="true" />
                </RadioGroup>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/optionsLayout"
            app:layout_constraintBottom_toBottomOf="parent">

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/cancel"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:background="@drawable/button_outline"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnRegister"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/register"
                android:textAllCaps="false"
                android:backgroundTint="#D3D3D3"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>